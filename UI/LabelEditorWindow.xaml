<Window x:Class="WindowMark.UI.LabelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowMarkLabelEditor"
        Width="328"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=LabelBox}">
    <Window.Resources>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#EDEDED" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#464646" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Foreground" Value="#171717" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="CaretBrush" Value="#FFD166" />
            <Setter Property="SelectionBrush" Value="#66FFD166" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#88FFD166" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F0202020"
            CornerRadius="12"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="16">
        <StackPanel>
            <DockPanel x:Name="HeaderRow" Background="Transparent">
                <Button x:Name="CloseButton"
                        DockPanel.Dock="Right"
                        Content="✕"
                        Style="{StaticResource ChipButton}"
                        Padding="8,2"
                        FontSize="11"
                        Focusable="False"
                        Background="Transparent" />
                <TextBlock Text="窗口标签"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock x:Name="TargetText"
                       Foreground="#9C9C9C"
                       FontSize="11"
                       Margin="0,6,0,12"
                       TextTrimming="CharacterEllipsis" />

            <TextBox x:Name="LabelBox" Style="{StaticResource DarkTextBox}" MaxLength="24" />

            <TextBlock Text="颜色" Foreground="#8F8F8F" FontSize="11" Margin="1,12,0,6" />
            <WrapPanel x:Name="Swatches" />

            <DockPanel Margin="0,14,0,0">
                <Button x:Name="SaveButton"
                        DockPanel.Dock="Right"
                        Content="保存"
                        Style="{StaticResource AccentButton}"
                        Width="72" />
                <Button x:Name="CancelButton"
                        DockPanel.Dock="Right"
                        Content="取消"
                        Style="{StaticResource ChipButton}"
                        Width="64"
                        Margin="0,0,8,0" />
                <Button x:Name="DeleteButton"
                        Content="删除标签"
                        Style="{StaticResource ChipButton}"
                        Width="84"
                        HorizontalAlignment="Left"
                        Foreground="#FF9B9B"
                        Background="#2A2222" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
